# Copy to backend/.env on the VPS and fill in real values.
# NEVER commit the filled-in .env file.

# MySQL (matches backend/docker-compose.yml — change the passwords there too)
DATABASE_URL=mysql+pymysql://kelasi:CHANGE_ME_DB_PASSWORD@localhost:3306/kelasi

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRE_MINUTES=10080
COOKIE_NAME=kelasi_session

# Same-origin deployment behind Caddy (frontend + /api/* on one domain) means
# CORS is mostly moot, but FastAPI still needs an explicit allowed origin.
CORS_ORIGIN=https://kelasi.example.com

ENV=production
