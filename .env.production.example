# Copy to .env.production at the repo root on the VPS, then run `npm run build`.
# NEXT_PUBLIC_* vars are baked in at build time — this file must exist and be
# correct BEFORE building, not just before starting.

# Caddy serves the frontend and /api/* from the same domain, so a relative
# path works and avoids CORS entirely. Only change this if the API lives on
# a different domain than the frontend.
NEXT_PUBLIC_API_URL=/api/v1
